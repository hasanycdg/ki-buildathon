# Automatic Lesson Creator (Mistral)
# For this browser-only prototype. In production, keep this key on a backend proxy.
VITE_MISTRAL_API_KEY=
VITE_MISTRAL_MODEL=mistral-small-latest

# Existing image analysis prototype
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-opus-5
# Server-seitiger OpenAI-Key fuer den echten Quick-Help-Chatbot.
# Bitte niemals als VITE_-Variable speichern, sonst landet der Key im Browser.
OPENAI_API_KEY=sk-proj-...

# Optional. Wenn leer, nutzt der lokale API-Endpunkt gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini